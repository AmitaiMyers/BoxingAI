    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-screen-orientation": "~58.0.4",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
