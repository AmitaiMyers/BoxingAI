{
  "expo": {
    "name": "Boxing AI",
    "slug": "boxing-ai",
    "scheme": "boxingai",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14161a",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      ["expo-screen-orientation", { "initialOrientation": "LANDSCAPE" }]
    ]
  }
}
